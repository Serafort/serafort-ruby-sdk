#!/bin/sh
# Portable pre-commit hook for the Serafort Ruby SDK.
#
# This is a Ruby gem with no npm/Node.js involved, so Husky (an npm-ecosystem
# tool) does not apply here. This plain POSIX shell script, wired in via
# `git config core.hooksPath .githooks`, is the idiomatic dependency-free
# equivalent for a Ruby repo.
#
# Enable it once per clone with:
#   git config core.hooksPath .githooks

set -e

echo "[pre-commit] Checking Ruby syntax..."
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.rb'); do
	if [ -f "$f" ]; then
		ruby -c "$f" >/dev/null
	fi
done

echo "[pre-commit] Running rspec..."
bundle exec rspec

echo "[pre-commit] All checks passed."
